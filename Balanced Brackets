public static String isBalanced(String s) {
    
            Stack<Character> st= new Stack<>();
            char[] arr = s.toCharArray();
           for(int i=0;i<s.length();i++){
            char c= arr[i];
            if((c=='[')||(c=='{')||(c=='(') )
                st.push(c);
            if((c==']')||(c=='}')||(c==')')){
                if(st.isEmpty()) return "NO";
                
                char top=st.pop();
                 if((c==']'&& top!='[') || (c=='}'&& top!='{') || (c==')'&& top!='(')) {
                    return "NO";
                }
            }
           }   
        return  st.isEmpty()? "YES": "NO"; 
    }
